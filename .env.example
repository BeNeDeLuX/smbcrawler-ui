# Copy to .env and adjust before `docker compose up`.

# --- Web UI auth (single shared password) ---
APP_PASSWORD=changeme
# Session cookie signing key. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=please-generate-a-random-value
# Fernet key for encrypting scan credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=please-generate-a-fernet-key

# --- Postgres ---
POSTGRES_USER=smbcrawler
POSTGRES_PASSWORD=smbcrawler
POSTGRES_DB=smbcrawler_ui

# --- Wiring (usually leave as-is) ---
DATABASE_URL=postgresql+psycopg://smbcrawler:smbcrawler@db:5432/smbcrawler_ui
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
# Max parallel running scans handled by the worker.
SCAN_CONCURRENCY=2

# --- Ports ---
API_PORT=8000
# HTTPS, via the `proxy` container. Auto-generates a self-signed certificate
# on first boot; upload your own under Settings in the UI (or POST
# /api/tls/certificate). Prefer this over API_PORT outside a trusted LAN.
TLS_PORT=8443

# --- Images (usually leave as-is) ---
# Defaults to what docker-publish.yml builds and pushes on every push to
# main. Only needed to publish under a different Docker Hub account/tag, or
# when using docker-compose.build.yml locally (which overrides these with
# locally built images regardless).
#SMBCRAWLER_UI_IMAGE=benedelux/smbcrawler-ui:latest
#SMBCRAWLER_UI_PROXY_IMAGE=benedelux/smbcrawler-ui-proxy:latest
